.venv/

# Local secrets. README tells you to put HF_TOKEN here, and this repo is
# public — without this line a token lands in the first `git add -A`.
.env
.env.*
!.env.example
__pycache__/
*.pyc
.pytest_cache/
.dubtool_work/
poc/models/
poc/CosyVoice/
poc/*.log
*.egg-info/
build/
dist/
.DS_Store
output/

# Extracted voice-reference clips derived from whatever real (often
# copyrighted) content the user dubs — same concern as the poc/ allowlist
# below, not ours to redistribute.
voice_bank/

# Real, user-supplied test media (recordings, copyrighted clips, ...) is
# not ours to redistribute publicly. Allowlist rather than blocklist so a
# new test file dropped into poc/ (there have already been several, by
# different names each time) is excluded by default instead of needing a
# new .gitignore line remembered every time — only synthetic/generated
# assets we made ourselves are explicitly let through.
poc/*
!poc/poc_infer.py
!poc/reference.wav
!poc/output_uzbek_cloned.wav

# Local test media dropped in the repo root
/*.mp3

# Scratch directory voice_clone_test.py writes into (extracted audio,
# Demucs stems, sliced references, synthesized output). Regenerated on
# every run and derived from user-supplied media -- same concern as
# voice_bank/ above.
work/

# Real source clips dropped at the repo root to try the tool on (JJK.mp4,
# "Naruto scene.mp4", ...). Copyrighted, not ours to redistribute, and a
# new one appears under a different name each time -- so ignore the whole
# pattern rather than naming files. Root-anchored so the synthetic
# tests/integration fixture still tracks.
/*.mp4
/*.mkv
/*.mov

# Episodes you want to dub (copyrighted, not ours to redistribute)
/input/
